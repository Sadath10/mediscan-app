# DEEPREAD_API_KEY: DeepRead AI OCR API key for medicine packaging text extraction (deepread.tech).
DEEPREAD_API_KEY=""

# SAFERX_API_KEY: SafeRx Drug Safety API key for food interactions, side effects, and black box warnings (docs.saferx.online)
SAFERX_API_KEY=""

# FIREBASE_PROJECT_ID: Firebase project ID (e.g. praxis-module-d53bd)
FIREBASE_PROJECT_ID="praxis-module-d53bd"

# FIREBASE_CLIENT_EMAIL: Firebase Admin service account email
FIREBASE_CLIENT_EMAIL=""

# FIREBASE_PRIVATE_KEY: Firebase Admin private key
FIREBASE_PRIVATE_KEY=""

# OPENFDA_API_KEY: (Optional) openFDA API key for higher request rate limits (api.fda.gov)
OPENFDA_API_KEY=""
